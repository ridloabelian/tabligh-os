# ==============================================================================
# tabligh-os Configuration
# ==============================================================================

# HTTP Server & SQLite State Store
PORT=8791
TABLIGH_HOST=127.0.0.1
TABLIGH_DB_PATH=./data/tabligh.db
TABLIGH_STAGING_DIR=./data/staging
TABLIGH_DASHBOARD_URL=http://localhost:8791

# Attribution / edge-funnel
EDGE_FUNNEL_BASE_URL=https://ridlo.id

# ------------------------------------------------------------------------------
# Official API Transports (Auto-Scheduled / Auto-Published after validation)
# ------------------------------------------------------------------------------
# YouTube Data API v3 (OAuth2 Access Token)
YOUTUBE_ACCESS_TOKEN=

# X (Twitter) API v2 (OAuth2 User Context Access Token / Bearer)
X_BEARER_TOKEN=

# LinkedIn Posts API (OAuth2 Access Token & Author URN, e.g. urn:li:person:...)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# Meta Graph API (Instagram Reels/Carousel & Threads)
META_GRAPH_TOKEN=
INSTAGRAM_IG_USER_ID=
THREADS_USER_ID=

# EmDash CMS (ridlo.id)
EMDASH_URL=https://ridlo.id
EMDASH_TOKEN=

# WhatsApp Channel Broadcast Webhook (waflare compatible)
WAFLARE_CHANNEL_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# Interactive Status Notifications (WhatsApp via waflare & Telegram Bot API)
# ------------------------------------------------------------------------------
WAFLARE_WEBHOOK_URL=
WAFLARE_AUTH_TOKEN=
WAFLARE_TARGET_JID=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# Optional Local Browser CDP Endpoint (Human-in-the-Loop Draft-Filler)
# Launch Chrome/Chromium with --remote-debugging-port=9222 using your profile.
# tabligh-os NEVER stores passwords and NEVER clicks Publish on CDP platforms.
# ------------------------------------------------------------------------------
CHROME_CDP_URL=http://127.0.0.1:9222
